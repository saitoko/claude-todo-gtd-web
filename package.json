{
  "name": "todo-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Local web app for managing /todo skill tasks (GitHub Issues GTD)",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c cyan,magenta \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:server": "node server/index.js",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test server/lib/gtd-labels.test.js server/lib/github-issue-repository.test.js server/lib/engine-sync.test.js server/lib/github-issue-repository-detail.test.js server/lib/github-issue-repository-done.test.js server/lib/github-issue-repository-undo-done.test.js server/routes/tasks-done.test.js server/routes/tasks-routes.test.js server/routes/tasks-validation.test.js server/routes/tasks-undo-done.test.js",
    "test:filter": "node --experimental-strip-types --test src/lib/filterTasks.test.ts",
    "test:taskbody": "node --experimental-strip-types --test src/lib/taskBody.test.ts",
    "test:api": "node --experimental-strip-types --test src/lib/api.test.ts",
    "test:recurnotice": "node --experimental-strip-types --test src/lib/recurNotice.test.ts",
    "test:partitionbydate": "node --experimental-strip-types --test src/lib/partitionByDate.test.ts",
    "test:taskdetailescape": "node --experimental-strip-types --test src/lib/taskDetailEscape.test.ts",
    "test:usetoast": "node --experimental-strip-types --test src/lib/useToast.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
